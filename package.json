{
  "name": "@wyre-ai/node-proofpoint-essentials",
  "version": "1.0.0",
  "description": "Node.js/TypeScript client library for the Proofpoint Essentials API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WYRE-AI/node-proofpoint-essentials.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "proofpoint",
    "proofpoint-essentials",
    "api-client",
    "sdk",
    "typescript",
    "msp"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@semantic-release/github": "^10.0.0",
    "@semantic-release/npm": "^11.0.0",
    "msw": "^2.0.0",
    "semantic-release": "^23.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
